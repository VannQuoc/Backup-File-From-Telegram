# Bảo mật Web Panel: Điền chuỗi SHA-256 (64 ký tự hex) của mật khẩu Admin
# Ví dụ bên dưới là SHA-256 của "admin123": 240be518fabd2724ddb6f04eeb1da5967448d7e831c08c8fa822809f74c720a9
WEB_ADMIN_PASSWORD_SHA256=240be518fabd2724ddb6f04eeb1da5967448d7e831c08c8fa822809f74c720a9
WEB_SESSION_SECRET=change-this-secret-key-for-hmac-token-signing

# Cấu hình Server Web Panel
WEB_HOST=127.0.0.1
WEB_PORT=8000

# Cấu hình Telegram API mặc định (có thể ghi đè riêng trên từng Account trong Web Panel)
DEFAULT_TG_API_ID=
DEFAULT_TG_API_HASH=

# Đường dẫn lưu trữ dữ liệu
DATA_DIR=./data
DB_PATH=./data/state.sqlite
SESSIONS_DIR=./data/sessions
UPLOADS_DIR=./data/uploads
TEMP_DIR=./data/temp
LOG_PATH=./data/logs/app.log

# Chu kỳ quét đồng bộ & lập lịch (giây)
BACKUP_RECONCILE_INTERVAL_SECONDS=120
AUTO_SEND_TICK_SECONDS=5
